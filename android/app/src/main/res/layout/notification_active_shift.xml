<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Main Content: Status + Ring Timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Status pill + subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Status pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notif_pill_bg"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Green dot: Use ImageView (View is NOT supported in RemoteViews) -->
                <ImageView
                    android:id="@+id/dot_icon"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/notif_dot_bg"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="status" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shift in progress"
                    android:textColor="@color/notif_pill_text"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time left until safe exit"
                android:textColor="@color/notif_text_subtitle"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Right: Circular Progress + Chronometer -->
        <RelativeLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginStart="12dp">

            <!-- Normal Shift Progress (Yellow) -->
            <ProgressBar
                android:id="@+id/progress_circle"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/notif_circular_progress" />

            <!-- Break Progress (Grey) -->
            <ProgressBar
                android:id="@+id/progress_circle_break"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/notif_circular_progress_grey" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <Chronometer
                    android:id="@+id/chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/notif_text_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/left_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEFT"
                    android:textColor="@color/notif_text_subtitle"
                    android:textSize="8sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notif_btn_pause_bg"
            android:text="Take a Break"
            android:textColor="@color/notif_btn_pause_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_clock_out"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/notif_btn_clockout_bg"
            android:text="Clock Out"
            android:textColor="@color/notif_btn_clockout_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
