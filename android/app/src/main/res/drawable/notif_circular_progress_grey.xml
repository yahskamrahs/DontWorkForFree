<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadius="36dp" android:thickness="6dp" android:useLevel="false">
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270">
            <shape android:shape="ring" android:innerRadius="36dp" android:thickness="6dp" android:useLevel="true">
                <!-- Grey color for break -->
                <solid android:color="#9CA3AF" />
            </shape>
        </rotate>
    </item>
</layer-list>
